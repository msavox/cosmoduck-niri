# versions.env — pinned upstream refs for the Cosmoduck-niri jammy backport.
# Sourced by every build/*.sh script. Bump a ref here to rebuild against a
# newer upstream; the patches under build/patches/ may then need a refresh.

# niri compositor (https://github.com/YaLTeR/niri)
NIRI_REPO="https://github.com/YaLTeR/niri.git"
NIRI_REF="v26.04"            # commit 8ed0da44d974c32c6877d2f4630c314da0717ecb

# libwayland — newer than jammy's 1.20; fixes Firefox "wl_pointer has no event 9"
WAYLAND_REPO="https://gitlab.freedesktop.org/wayland/wayland.git"
WAYLAND_REF="1.23.1"

# libdisplay-info — niri runtime dep, not packaged on jammy (ships di-edid-decode too)
LIBDISPLAY_INFO_REPO="https://gitlab.freedesktop.org/emersion/libdisplay-info.git"
LIBDISPLAY_INFO_REF="0.2.0"

# Xwayland — built against the newer wayland above (jammy's Xwayland is too old)
XWAYLAND_REPO="https://gitlab.freedesktop.org/xorg/xserver.git"
XWAYLAND_REF="xwayland-23.1.0"

# xwayland-satellite — rootless Xwayland integration for niri
XWAYLAND_SATELLITE_REPO="https://github.com/Supreeeme/xwayland-satellite.git"
XWAYLAND_SATELLITE_REF="5d1efbc"

# SwayNotificationCenter (GTK3 build, reports 0.9.0)
SWAYNC_REPO="https://github.com/ErikReider/SwayNotificationCenter.git"
SWAYNC_REF="deaf9a6"

# nwg-dock — macOS-style dock
NWG_DOCK_REPO="https://github.com/nwg-piotr/nwg-dock.git"
NWG_DOCK_REF="v0.4.3"

# swaylock — jammy's 1.5 is incompatible (input-inhibitor); master reports v1.8.5
SWAYLOCK_REPO="https://github.com/swaywm/swaylock.git"
SWAYLOCK_REF="master"

# where sources are checked out and built
: "${WORKDIR:=$HOME/.cache/cosmoduck-niri-build}"
# install prefix for the compiled binaries/libraries
: "${PREFIX:=/usr/local}"
