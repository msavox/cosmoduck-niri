// Include monitor configuration generated by nwg-displays
include "monitor.kdl"

// ╔══════════════════════════════════════════════════════════════════╗
// ║  Niri config — beginner-friendly setup                          ║
// ║  Press  F1  (or  Super+Shift+?)  to see ALL the shortcuts       ║
// ║  Documentation: https://github.com/YaLTeR/niri/wiki             ║
// ╚══════════════════════════════════════════════════════════════════╝
//
// "Mod" below = Super key (Windows/Tux). KDL syntax: https://kdl.dev

// ════════ Input ════════════════════════════════════════════════════
input {
    keyboard {
        xkb {
            layout "it,us"
            variant ",intl"
            options "grp:alt_shift_toggle"
        }
        numlock
    }

    touchpad {
        tap
        dwt
        natural-scroll
        click-method "clickfinger"
        // accel-speed 0.2
    }

    mouse {
        natural-scroll
    }

    // Move focus by hovering the mouse over a fully visible window
    focus-follows-mouse max-scroll-amount="0%"
}

// ════════ Output ══════════════════════════════════════════════════
// Run `niri msg outputs` inside niri to discover the monitor names.
// Example (uncomment by removing the "/-" and adapt it):
/-output "eDP-1" {
    mode "1920x1080"
    scale 1.0
    position x=0 y=0
}

// ════════ Layout ══════════════════════════════════════════════════
layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#8aadf4"
        inactive-color "#494d64"
    }

    border {
        off
        width 2
        active-color "#8aadf4"
        inactive-color "#494d64"
        urgent-color "#ed8796"
    }

    shadow {
        on
        softness 24
        spread 4
        offset x=0 y=4
        color "#00000066"
    }

    struts {}
}

// ════════ Autostart ════════════════════════════════════════════════
// niri 26.04 manages xwayland-satellite internally: no manual spawn needed.
// Requires Xwayland >= 23.1 (installed in /usr/local/bin/Xwayland, built from source).
environment {
    DISPLAY ":0"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    // XDG_CURRENT_DESKTOP extended with wlroots: makes niri "match" the
    // wlr.portal of xdg-desktop-portal (UseIn=wlroots;sway;Wayfire;river),
    // so the `ScreenCast=wlr;` rule in ~/.config/xdg-desktop-portal/
    // niri-portals.conf enables xdpw and Teams can do screen share.
    // NB: this block only applies to children niri spawns; the portal is
    // D-Bus/systemd-activated and does NOT inherit it (stays "niri"). It is
    // propagated to systemd and the portal restarted by the spawn below.
    XDG_CURRENT_DESKTOP "niri:wlroots"
}
// The xdg-desktop-portal frontend is systemd-activated with
// XDG_CURRENT_DESKTOP=niri (no :wlroots): the wlr backend is then "not
// eligible", ScreenCast falls back to the gnome backend (AvailableSourceTypes=0)
// and screen sharing produces nothing. Push the value into the systemd manager
// and restart the portal so it binds the wlr backend (AvailableSourceTypes=1).
spawn-sh-at-startup "systemctl --user set-environment XDG_CURRENT_DESKTOP=niri:wlroots && systemctl --user restart xdg-desktop-portal.service"
spawn-at-startup "waybar" "-c" "__HOME__/.config/waybar/config.jsonc" "-s" "__HOME__/.config/waybar/style.css"
spawn-at-startup "waybar" "-c" "__HOME__/.config/waybar/dock.jsonc" "-s" "__HOME__/.config/waybar/dock.css"
spawn-sh-at-startup "sleep 1 && __HOME__/.config/waybar/tray-toggle.sh start-if-open"
spawn-at-startup "/usr/libexec/gsd-rfkill"
spawn-at-startup "swaync" "-c" "__HOME__/.config/swaync/config.json" "-s" "__HOME__/.config/swaync/style.css"
spawn-at-startup "/usr/bin/python3" "__HOME__/.config/waybar/notif-count.py" "daemon"
// auto-pin temporaneo: le app aperte non pinnate diventano moduli del dock
// (così hanno il menu contestuale); spinnate quando chiudono.
spawn-sh-at-startup "exec /usr/bin/python3 __HOME__/.config/waybar/dock-autopin.py 2>>__HOME__/.config/waybar/dock-autopin.err"
// OSD volume/luminosità stile macOS (card bottom-center, vedi osd.py)
spawn-sh-at-startup "exec /usr/bin/python3 __HOME__/.config/niri/osd.py 2>>/tmp/cosmoduck-osd.err"
spawn-sh-at-startup "__HOME__/.config/niri/gnome-wallpaper-sync.sh"
spawn-at-startup "/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "ulauncher" "--hide-window"
// Autolock disabled (lock manually with Super+L). To re-enable, uncomment:
// spawn-sh-at-startup "swayidle -w timeout 600 '$HOME/.config/niri/swaylock-blur.sh' before-sleep '$HOME/.config/niri/swaylock-blur.sh'"
spawn-sh-at-startup "sleep 3 && __HOME__/.config/niri/conky-spawn.sh"
spawn-sh-at-startup "sleep 5 && __HOME__/.config/niri/conky-bg-launch.sh"
spawn-sh-at-startup "sleep 5 && __HOME__/.config/niri/desktop-launch.sh"
spawn-sh-at-startup "__HOME__/.config/niri/cheatsheet-startup.sh"

// ════════ Cheatsheet ═══════════════════════════════════════════════
// The shortcuts "widget" is built into niri: it appears in the top
// right at startup and can be recalled at any time with  F1.
hotkey-overlay {
    skip-at-startup   // niri does not show it on its own: cheatsheet-startup.sh handles it
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

animations {
    // off
    // slowdown 1.5
}

// ════════ Window rules ═════════════════════════════════════════════
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"^pavucontrol$"#
    open-floating true
    default-column-width { fixed 600; }
}

// zenity volume slider -> small, floating, anchored near the cursor
window-rule {
    match app-id=r#"^zenity$"# title="^Volume$"
    open-floating true
    default-column-width { fixed 340; }
    default-window-height { fixed 130; }
}

// Ulauncher -> anchored top-center (Spotlight style)
window-rule {
    match app-id=r#"^ulauncher$"#
    open-floating true
    default-floating-position x=0 y=140 relative-to="top"
    geometry-corner-radius 40
    clip-to-geometry true
}

// Tray dropdown -> floating below the chevron in waybar (estimate: chevron is ~500px from the right edge)
window-rule {
    match app-id=r#"^tray-dropdown$"#
    open-floating true
    default-floating-position x=300 y=7 relative-to="top-right"
    focus-ring {
        off
    }
    border {
        off
    }
}

// Dock context menu (right-click on a dock icon) -> floating, anchored just
// above the dock at the bottom-center of the screen.
window-rule {
    match app-id=r#"^dock-menu$"#
    open-floating true
    default-floating-position x=0 y=80 relative-to="bottom"
    focus-ring {
        off
    }
    border {
        off
    }
}

// Conky (Cosmoduck) -> the visible rendering is done by conky-bg.py via
// layer-shell BACKGROUND. The niri toplevel of conky must stay active
// (so the X server sends it Damage) but invisible above the apps.
// opacity 0.0 + open-focused false + no borders.
window-rule {
    match app-id=r#"(?i)^conky$"#
    open-floating true
    default-floating-position x=1 y=15 relative-to="top-left"
    open-focused false
    opacity 0.0
    focus-ring {
        off
    }
    border {
        off
    }
    // opacity 0.0 hides the content, but niri still drew the drop-shadow
    // around the invisible toplevel -> "ghost window" on conky's workspace.
    // Turn the shadow off (the real render is the layer-shell surface).
    shadow {
        off
    }
}

// MATLAB -> open maximized (Mod+F equivalent). Avoids the warning
// "MATLAB:hg:set_chck:DimensionsOutsideRange" that AWT raises when the
// window starts half-screen with a multi-monitor offset.
window-rule {
    match app-id=r#"(?i)^MATLAB"#
    open-maximized true
}

// Shortcuts cheatsheet: floating and centered window.
window-rule {
    match app-id=r#"^niri-cheatsheet$"#
    open-floating true
}

// ════════ Shortcuts ════════════════════════════════════════════════
binds {
    // ─── Cheatsheet ───────────────────────────────────────────────
    F1               hotkey-overlay-title="Show/hide keyboard cheatsheet" { spawn-sh "python3 $HOME/.config/niri/cheatsheet.py"; }
    Mod+Shift+Slash  hotkey-overlay-title="Show/hide keyboard cheatsheet" { spawn-sh "python3 $HOME/.config/niri/cheatsheet.py"; }

    // ─── Launchers ───────────────────────────────────────────────
    Mod+Return  hotkey-overlay-title="Terminal (ghostty)"            { spawn "ghostty"; }
    Mod+T       hotkey-overlay-title="Terminal (ghostty)"            { spawn "ghostty"; }
    Mod+D       hotkey-overlay-title="Ulauncher"                     { spawn "ulauncher-toggle"; }
    Mod+A       hotkey-overlay-title="App grid launcher"             { spawn-sh "/usr/bin/python3 $HOME/.config/niri/app-grid.py"; }
    Ctrl+Space  hotkey-overlay-title="Ulauncher"                     { spawn "ulauncher-toggle"; }
    Mod+B       hotkey-overlay-title="Browser (firefox)"             { spawn "firefox"; }
    Mod+E       hotkey-overlay-title="Open Home folder"              { spawn "xdg-open" "__HOME__"; }

    // ─── Session ──────────────────────────────────────────────────
    Super+L         hotkey-overlay-title="Lock screen"                { spawn-sh "$HOME/.config/niri/swaylock-blur.sh"; }
    Mod+Shift+E     hotkey-overlay-title="Quit niri (with confirmation)" { quit; }
    Ctrl+Alt+Delete hotkey-overlay-title="Quit niri (with confirmation)" { quit; }
    Mod+Shift+P     hotkey-overlay-title="Power off monitors"         { power-off-monitors; }

    // ─── Windows ──────────────────────────────────────────────────
    Mod+Q       hotkey-overlay-title="Close window"                   { close-window; }
    Mod+O       repeat=false hotkey-overlay-title="Workspaces overview" { toggle-overview; }
    Mod+V       hotkey-overlay-title="Toggle floating/tiling"         { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Switch focus between floating and tiling" { switch-focus-between-floating-and-tiling; }
    Mod+W       hotkey-overlay-title="Toggle tabbed display in column" { toggle-column-tabbed-display; }
    Mod+Space   hotkey-overlay-title="Cycle keyboard layout"          { spawn "niri" "msg" "action" "switch-layout" "next"; }

    // ─── Window focus ─────────────────────────────────────────────
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }
    Mod+Up     { focus-window-up; }
    Mod+Down   { focus-window-down; }
    Mod+H      { focus-column-left; }
    // Mod+L removed: collides with Super+L (lock). Use Mod+Right to focus right.
    Mod+K      { focus-window-up; }
    Mod+J      { focus-window-down; }
    Mod+Home   { focus-column-first; }
    Mod+End    { focus-column-last; }

    // ─── Move window ──────────────────────────────────────────────
    Mod+Ctrl+Left   { move-column-left; }
    Mod+Ctrl+Right  { move-column-right; }
    Mod+Ctrl+Up     { move-window-up; }
    Mod+Ctrl+Down   { move-window-down; }
    Mod+Ctrl+H      { move-column-left; }
    Mod+Ctrl+L      { move-column-right; }
    Mod+Ctrl+K      { move-window-up; }
    Mod+Ctrl+J      { move-window-down; }
    Mod+Ctrl+Home   { move-column-to-first; }
    Mod+Ctrl+End    { move-column-to-last; }

    // ─── Multi-monitor ────────────────────────────────────────────
    Mod+Shift+Left   { focus-monitor-left; }
    Mod+Shift+Right  { focus-monitor-right; }
    Mod+Shift+Up     { focus-monitor-up; }
    Mod+Shift+Down   { focus-monitor-down; }

    Mod+Shift+Ctrl+Left   { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right  { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down   { move-column-to-monitor-down; }

    // ─── Workspaces ───────────────────────────────────────────────
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Tab            hotkey-overlay-title="Previous workspace"    { focus-workspace-previous; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ─── Scrollable tiling (niri's quirk) ─────────────────────────
    Mod+BracketLeft  hotkey-overlay-title="Consume/expel window left"   { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume/expel window right"  { consume-or-expel-window-right; }
    Mod+Comma        hotkey-overlay-title="Consume window from right"   { consume-window-into-column; }
    Mod+Period       hotkey-overlay-title="Expel window from column"    { expel-window-from-column; }

    // ─── Sizes ────────────────────────────────────────────────────
    Mod+R           hotkey-overlay-title="Cycle preset column widths"          { switch-preset-column-width; }
    Mod+Shift+R     hotkey-overlay-title="Cycle preset column widths (back)"   { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Cycle preset window heights"         { switch-preset-window-height; }
    Mod+F           hotkey-overlay-title="Maximize column"                     { maximize-column; }
    Mod+Shift+F     hotkey-overlay-title="Fullscreen window"                   { fullscreen-window; }
    Mod+Shift+B     hotkey-overlay-title="Hide/show waybar + dock (presentation mode)" { spawn-sh "$HOME/.config/waybar/presentation-toggle.sh"; }
    Mod+Shift+D     hotkey-overlay-title="Show desktop (toggle)"               { spawn-sh "$HOME/.config/niri/show-desktop.sh"; }
    Mod+M           hotkey-overlay-title="Maximize window to screen edges"     { maximize-window-to-edges; }
    Mod+C           hotkey-overlay-title="Center column"                       { center-column; }
    Mod+Ctrl+F      hotkey-overlay-title="Expand column to available width"    { expand-column-to-available-width; }
    // On the IT layout the "Equal" keysym is only reachable with Shift and "Shift+Minus"
    // becomes "underscore": so I use the +* key (keysym Plus, plain on IT)
    // and Ctrl instead of Shift (Ctrl does not alter the keysym). "Equal" stays for US.
    Mod+Minus      { set-column-width "-10%"; }
    Mod+Plus       { set-column-width "+10%"; }
    Mod+Equal      { set-column-width "+10%"; }
    Mod+Ctrl+Minus { set-window-height "-10%"; }
    Mod+Ctrl+Plus  { set-window-height "+10%"; }
    Mod+Ctrl+Equal { set-window-height "+10%"; }

    // ─── Screenshot ───────────────────────────────────────────────
    Print       hotkey-overlay-title="Screenshot region"             { screenshot; }
    Ctrl+Print  hotkey-overlay-title="Screenshot full screen"         { screenshot-screen; }
    Alt+Print   hotkey-overlay-title="Screenshot window"              { screenshot-window; }

    // ─── Volume / Media / Brightness ──────────────────────────────
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "/usr/bin/pactl set-sink-volume @DEFAULT_SINK@ +5%; __HOME__/.config/niri/osd-notify.sh volume"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "/usr/bin/pactl set-sink-volume @DEFAULT_SINK@ -5%; __HOME__/.config/niri/osd-notify.sh volume"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "/usr/bin/pactl set-sink-mute @DEFAULT_SINK@ toggle; __HOME__/.config/niri/osd-notify.sh mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "/usr/bin/pactl set-source-mute @DEFAULT_SOURCE@ toggle; __HOME__/.config/niri/osd-notify.sh mic"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop         allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "/usr/bin/brightnessctl set 5%+; __HOME__/.config/niri/osd-notify.sh brightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "/usr/bin/brightnessctl set 5%-; __HOME__/.config/niri/osd-notify.sh brightness"; }

    // ─── Escape hatch for remote-desktop apps ─────────────────────
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
