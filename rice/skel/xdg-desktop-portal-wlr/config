# xdg-desktop-portal-wlr screencast chooser.
# dmenu mode: xdpw pipes the output (monitor) names to wofi --dmenu and uses
# the selected one. With a single monitor xdpw auto-selects it (no prompt).
# Switch back to `chooser_type=simple` / `chooser_cmd=slurp -f %o -or` to pick
# the monitor by clicking on it instead of choosing from a list.
[screencast]
chooser_type=dmenu
chooser_cmd=wofi --dmenu --prompt "Select monitor to share"
max_fps=30
