# package staging (regenerated by packaging/build-deb.sh)
packaging/build/

# python caches
__pycache__/
*.pyc

# editor / config backups and runtime state
*.bak
*.bak-*
.tray-state

# local build checkout (default WORKDIR lives in ~/.cache, but just in case)
.cache/
*.tar.xz

# the prebuilt .deb is distributed via GitHub Releases, not committed
dist/*.deb

# stray VirtualBox dxvk cache
VBoxHeadless.dxvk-cache
*.dxvk-cache
